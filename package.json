{
  "name": "gh-sonifier",
  "version": "0.1.0",
  "private": true,
  "description": "Hear a GitHub contribution graph. Chrome extension, zero runtime dependencies, raw Web Audio.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test tests/",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
